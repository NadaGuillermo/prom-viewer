# "mock" (default) reads FHIR data from public/ fixtures; "smart" fetches via SMART on FHIR
VITE_DATA_SOURCE=smart

# Base url of the open, unauthenticated FHIR server hosting Questionnaire/ObservationDefinition.
# Required when VITE_DATA_SOURCE=smart.
VITE_FHIR_DEFINITIONS_BASE_URL=https://fhir.simplifier.net/MII-Erweiterungsmodul-PRO-2025

# SMART on FHIR client id used by launch.html. Required when VITE_DATA_SOURCE=smart.
VITE_SMART_CLIENT_ID=b3c8350a-fbba-4bdb-b104-fa7eb1937b07
