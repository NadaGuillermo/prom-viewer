# "mock" (default) reads FHIR data from public/ fixtures; "smart" fetches via SMART on FHIR
VITE_DATA_SOURCE=smart

# Base url of the open, unauthenticated FHIR server hosting Questionnaire.
# Required when VITE_DATA_SOURCE=smart.
VITE_FHIR_QUESTIONNAIRE_BASE_URL=https://fhir.simplifier.net/MII-Erweiterungsmodul-PRO-2025

# Base url of the open, unauthenticated FHIR server hosting ObservationDefinition.
# Required when VITE_DATA_SOURCE=smart.
VITE_FHIR_OBSDEF_BASE_URL=https://fhir.simplifier.net/MII-Erweiterungsmodul-PRO-2025


# SMART on FHIR client id used by launch.html. Required when VITE_DATA_SOURCE=smart.
VITE_SMART_CLIENT_ID=0e565de9-0a9c-4d41-b02d-788948141047

# "local" (default) reads config files (proms, colors, dateFormat) from public/config;
# "remote" fetches them from VITE_CONFIG_SERVER_URL instead.
VITE_CONFIG_SOURCE=remote

# Base url to fetch config files from when VITE_CONFIG_SOURCE=remote.
# Required when VITE_CONFIG_SOURCE=remote.
VITE_CONFIG_SERVER_URL=http://localhost