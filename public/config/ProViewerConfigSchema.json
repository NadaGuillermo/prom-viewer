{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/example.json",
    "title": "PRO Viewer Configuration",
    "description": "Configuration settings for PRO Viewer: defines questionnaires; maps questionnaire items with domains & scores with observation definitions; defines score ranges and score health correlations; defines global health dimensions",
    "type": "object",
    "$definitions": {
        "scoreDefinitions": {
            "type": "array",
            "description": "Defines range and score health correlation of scores",
            "$comment": "If there exists a FHIR ObservationDefinition with ObservationDefinition.qualifiedInterval.range defined for a score also occuring in the config file, the values in the config file are given priority over those in the ObservationDefinition",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "range": {
                        "type": "array",
                        "description": "Specifies the range of the score as a tuple of two numbers (min, max)",
                        "items": {
                            "type": "number"
                        },
                        "minItems": 2,
                        "maxItems": 2
                    },
                    "scoreHealthCorrelation": {
                        "description": "Specifies the health score correlation; either increase (higher scores mean better health) or decrease (higher scores mean worse health)",
                        "enum": [
                            "increase",
                            "decrease"
                        ]
                    },
                    "referenceRange": {
                        "type": "array",
                        "description": "Specifies one or more reference ranges or values for the score",
                        "items": {
                            "type": "object",
                            "properties": {
                                "range": {
                                    "description": "Range as an array of lenth 2 (min, max) or value as an array of length 1",
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 1,
                                    "maxItems": 2
                                },
                                "name": {
                                    "type": "string",
                                    "description": "Name of the reference range"
                                },
                                "description": {
                                    "type": "string",
                                    "description": "Description or or context for the reference range"
                                }
                            },
                            "required": ["range", "name"]                       
                        },
                        "minItems": 1                   
                    }
                },
                "required": ["id"]
            }
        }
    },
    "properties": {
        "scoreDefinitions": {
            "$ref": "#/$definitions/scoreDefinitions"
        },
        "questionnaires": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "questionnaire": {
                        "type": "string",
                        "format": "uri",
                        "description": "Canonical URI of FHIR Questionnaire resource"
                    },  
                    "domainItemMapping": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "domain": {
                                    "type": "string",
                                    "description": "Domain into which items are grouped"
                                },
                                "questions": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "itemId": {
                                                "type": "string",
                                                "description": "FHIR Questionnaire.item.linkId",
                                                "$comment": "This value should correspond to a linkId in the referenced Questionnaire resource"
                                            },
                                            "shortName": {
                                                "type": "string",
                                                "description": "Human readable, preferably short, name that should be displayed in the chart",
                                                "$comment": "Useful for all scores or if FHIR Questionnaire.item.text is not defined or item.linkId very long",
                                                "maxLength": 25
                                            },
                                            "observationDefinition": {
                                                "type": "string",
                                                "format": "uri",
                                                "description": "Canonical URI of FHIR ObservationDefinition resource"
                                            },
                                            "scoreDefinitionId": {
                                                "type": "string",
                                                "description": "Id of an item in scoreDefinitions",
                                                "$comment": "Must match an id from scoreDefinitions"
                                            },
                                            "isDimensionScore": {
                                                "type": "boolean",
                                                "description": "Flag that determines whether the item is treated as a score for a health dimension",
                                                "$comment": "Scores of a questionnaire should be marked as scores. Sometimes even simple items can be scores"
                                            },
                                            "dimension": {
                                                "type": "string",
                                                "description": "Dimension to which is measured by the item",
                                                "$comment": "If isDimensionScore is set to true, a dimension must be given. If the isDimensionScore is not set, an item is assigned to a dimension either through the value in this field or through reference in a dimension score's calculation expression"
                                            }
                                        },
                                        "required": ["itemId"],
                                        "if": {
                                          "properties": {
                                            "isDimensionScore": { "const": true }
                                          },
                                          "required": ["isDimensionScore"]
                                        },
                                        "then": {
                                          "required": []
                                        }
                                    },
                                    "minItems": 1
                                }
                            },
                            "required": []
                        },
                        "minItems": 1 
                    },
                    "globalScores": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "description": "Id of an item that represents a global or overall health score",
                            "$comment": "Must match an itemId from questions of the domainItemMapping array"                
                        }
                    }
                },
                "required": ["questionnaire", "domainItemMapping"]
            },
            "minItems": 1
        }
    },
    "required": ["scoreDefinitions", "questionnaires"]
}